NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_PASSWORD=change-me


# Public canonical URL — used by robots.txt, sitemap.xml, and OG metadata.
# Falls back to https://pitchpit.app if unset.
NEXT_PUBLIC_SITE_URL=https://pitchpit.app

# ─── Captcha (Cloudflare Turnstile) ──────────────────────────────────────
# Site key is loaded by components/Turnstile.tsx in the browser bundle.
# Secret key is used by lib/turnstile.ts on the server to verify tokens.
# Setup: cloudflare.com → Turnstile → Add site → managed challenge mode.
# When BOTH are unset, captcha is bypassed (safe default for local dev).
#
# Local dev: production site keys are pinned to specific hostnames in the
# Turnstile dashboard and will fail on localhost. Either (a) add `localhost`
# and `127.0.0.1` to the existing site's allowed hostnames, or (b) use
# Cloudflare's documented always-pass dummy keys (public, official — see
# developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ─── Production rate-limiting (Upstash) ──────────────────────────────────
# Without these, middleware.ts uses an in-memory bucket that doesn't share
# state across Vercel serverless workers. Set both to switch on.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Sentry error reporting ───────────────────────────────────────────────
# Public DSN is loaded by sentry.client.config.ts in the browser bundle.
# Server DSN is loaded by sentry.server.config.ts + sentry.edge.config.ts.
# (They're typically the same value, just exposed under different prefixes.)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_DSN=https://...@sentry.io/...

# Sentry source-map upload (CI / Vercel build only — leave unset locally).
# SENTRY_AUTH_TOKEN=sntryu_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=pitch-pit

# ─── Google OAuth — configure in Supabase dashboard ───────────────────────
#   Auth → Providers → Google → enable + add Google Client ID/Secret from
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI in Google Cloud:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# Site URL in Supabase Auth:
#   http://localhost:3000  (dev)
#   https://pitchpit.app  (prod)

# ─── Marketing automation ────────────────────────────────────────────────
# Vercel Cron auth — generate any random string and set the SAME value in
# Vercel project settings → Environment Variables (production). The cron
# routes verify the `Authorization: Bearer ${CRON_SECRET}` header that
# Vercel Cron auto-attaches to requests.
#   openssl rand -hex 32
# CRON_SECRET=

# X (Twitter) API — OAuth 1.0a user-context, used by /api/cron/post-winner
# to auto-tweet the weekly winner. Free tier = 1,500 posts/month.
# Setup:
#   1. developer.x.com → create app
#   2. User authentication settings → OAuth 1.0a, Read+Write permissions
#   3. Generate access token + secret for the @pitchpit account
# When ANY of these is unset the cron logs a dry-run and returns 200 OK.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

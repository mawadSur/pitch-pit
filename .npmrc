# Lets `npm install` succeed despite the peer-dep mismatch in the
# eslint-config-next 16 / eslint 8 / @typescript-eslint chain. Without
# this flag, Vercel's CI install fails with ERESOLVE before the build
# even starts.
#
# Proper fix is to bump eslint to ^9 and migrate to the flat config
# format, which is what eslint-config-next 16 actually targets. Tracked
# as follow-up; this flag papers over the strict-peer-dep check until
# then. Doesn't affect runtime — only `npm install` resolution.
legacy-peer-deps=true
